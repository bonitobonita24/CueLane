# ═══════════════════════════════════════════════════════════════════════════════
# CueLane — Production environment variables
# Copy this file to .env.prod and fill in all placeholder values.
# ⚠ .env.prod is gitignored — never commit it.
# ═══════════════════════════════════════════════════════════════════════════════

# ── APP ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_URL=https://cuelane.powerbyte.app
APP_DOMAIN=cuelane.powerbyte.app

# ── DOCKER IMAGE (set by manual push.sh prod promotion) ──────────────────────
# Updated manually to the promoted image tag (e.g. sha-abc1234)
APP_IMAGE_TAG=latest

# ── TRAEFIK ─────────────────────────────────────────────────────────────────
TRAEFIK_NETWORK=proxy

# ── DATABASE ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cuelane_user:CHANGE_ME@postgres:5432/cuelane_prod?schema=public&pgbouncer=true
DIRECT_URL=postgresql://cuelane_user:CHANGE_ME@postgres:5432/cuelane_prod?schema=public

DB_USER=cuelane_user
DB_PASSWORD=CHANGE_ME
DB_NAME=cuelane_prod

# ── CACHE (Valkey) ───────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME@valkey:6379
REDIS_PASSWORD=CHANGE_ME

# ── FILE STORAGE (MinIO — S3-compatible, production bucket) ─────────────────
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_BUCKET=cuelane-prod
STORAGE_REGION=us-east-1

# ── AUTH ─────────────────────────────────────────────────────────────────────
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
AUTH_URL=https://cuelane.powerbyte.app

# ── SMTP (generic relay — fill from CREDENTIALS.md) ─────────────────────────
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=CueLane <noreply@cuelane.powerbyte.app>

# ── XENDIT (payment gateway — use LIVE keys for production) ──────────────────
XENDIT_SECRET_KEY=CHANGE_ME_xnd_production_...
XENDIT_WEBHOOK_TOKEN=CHANGE_ME
XENDIT_CALLBACK_URL=https://cuelane.powerbyte.app/api/webhooks/xendit

# ── TURNSTILE (Cloudflare — use LIVE keys for production) ────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=CHANGE_ME
TURNSTILE_SECRET_KEY=CHANGE_ME

# ── SUPER ADMIN (seed account — see CREDENTIALS.md) ─────────────────────────
SUPER_ADMIN_EMAIL=CHANGE_ME
SUPER_ADMIN_PASSWORD=CHANGE_ME
