# ═══════════════════════════════════════════════════════════════════════════════
# CueLane — Staging environment variables
# Copy this file to .env.staging and fill in all placeholder values.
# ⚠ .env.staging is gitignored — never commit it.
# ═══════════════════════════════════════════════════════════════════════════════

# ── APP ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_URL=https://cuelane-staging.powerbyte.app
APP_DOMAIN=cuelane-staging.powerbyte.app

# ── DOCKER IMAGE (Komodo Variable interpolated by CI — see docker-publish.yml) ──
# Komodo sets STAGING_IMAGE_TAG = [[CUELANE_STAGING_TAG]] before DeployStack.
# Leave blank in the file; Komodo injects the exact sha at deploy time.
STAGING_IMAGE_TAG=staging-latest

# ── TRAEFIK ─────────────────────────────────────────────────────────────────
TRAEFIK_NETWORK=proxy

# ── DATABASE ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cuelane_user:CHANGE_ME@postgres:5432/cuelane_staging?schema=public&pgbouncer=true
DIRECT_URL=postgresql://cuelane_user:CHANGE_ME@postgres:5432/cuelane_staging?schema=public

DB_USER=cuelane_user
DB_PASSWORD=CHANGE_ME
DB_NAME=cuelane_staging

# ── CACHE (Valkey) ───────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME@valkey:6379
REDIS_PASSWORD=CHANGE_ME

# ── FILE STORAGE (MinIO — S3-compatible, staging bucket) ────────────────────
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_BUCKET=cuelane-staging
STORAGE_REGION=us-east-1

# ── AUTH ─────────────────────────────────────────────────────────────────────
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
AUTH_URL=https://cuelane-staging.powerbyte.app

# ── SMTP (generic relay — fill from CREDENTIALS.md) ─────────────────────────
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=CueLane <noreply@cuelane-staging.powerbyte.app>

# ── XENDIT (payment gateway — use TEST keys for staging) ─────────────────────
XENDIT_SECRET_KEY=CHANGE_ME_xnd_development_...
XENDIT_WEBHOOK_TOKEN=CHANGE_ME
XENDIT_CALLBACK_URL=https://cuelane-staging.powerbyte.app/api/webhooks/xendit

# ── TURNSTILE (Cloudflare — use staging test keys) ───────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=CHANGE_ME
TURNSTILE_SECRET_KEY=CHANGE_ME

# ── SUPER ADMIN (seed account — see CREDENTIALS.md) ─────────────────────────
SUPER_ADMIN_EMAIL=CHANGE_ME
SUPER_ADMIN_PASSWORD=CHANGE_ME
