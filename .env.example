# ═══════════════════════════════════════════════════════════════════
# CueLane — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════
# HOW TO USE:
# 1. Copy this file: cp .env.example .env.dev
# 2. Fill in real values (or run Phase 3 to auto-generate them)
# 3. NEVER commit .env.dev, .env.staging, or .env.prod to git
# 4. NEVER commit CREDENTIALS.md to git (it is gitignored)
#
# FIRST ADMIN ACCOUNT (created by pnpm db:seed):
#   Username: webmaster
#   Password: see CREDENTIALS.md (gitignored — generated by Phase 3)
#   URL: http://localhost:41716/login
#
# All service passwords in CREDENTIALS.md are AI-generated strong passwords.
# Anyone cloning this repo must generate their own via Phase 3.
# ═══════════════════════════════════════════════════════════════════

COMPOSE_PROJECT_NAME=cuelane_dev
APP_ENV=development|staging|production
APP_PORT=41716

# DOCKER HUB IMAGE (staging/prod only)
# APP_IMAGE_TAG=staging-latest
# DOCKERHUB_USERNAME=your-dockerhub-username
# IMAGE_NAME=cuelane

# TRAEFIK (staging/prod only)
# TRAEFIK_NETWORK=proxy
# APP_DOMAIN=cuelane.yourdomain.com

# DATABASE
DB_HOST=localhost
DB_PORT=41706
DB_NAME=cuelane_dev
DB_USER=cuelane_your-11char-hex
DB_PASSWORD=your-db-password-here
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# PGBOUNCER
PGBOUNCER_PORT=41707
PGBOUNCER_AUTH_PASSWORD=your-pgbouncer-password-here
PGBOUNCER_DATABASE_URL=postgresql://${DB_USER}:${PGBOUNCER_AUTH_PASSWORD}@localhost:${PGBOUNCER_PORT}/${DB_NAME}

# CACHE (Valkey / Redis-compatible)
REDIS_HOST=localhost
REDIS_PORT=41708
REDIS_PASSWORD=your-redis-password-here
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# FILE STORAGE (MinIO — S3-compatible)
STORAGE_ENDPOINT=http://localhost:41709
STORAGE_CONSOLE_PORT=41710
STORAGE_BUCKET=cuelane-dev
STORAGE_ACCESS_KEY=cuelane-your-access-key-suffix
STORAGE_SECRET_KEY=your-storage-secret-key-48-chars-here
STORAGE_REGION=us-east-1

# AUTH
AUTH_SECRET=your-48-char-auth-secret-here
NEXTAUTH_URL=http://localhost:41716

# EMAIL (MailHog in dev — no real SMTP needed)
SMTP_HOST=localhost
SMTP_PORT=41711
SMTP_UI_PORT=41712
SMTP_FROM=dev@localhost
SMTP_FROM_NAME=CueLane Dev

# PGADMIN
PGADMIN_PORT=41713
PGADMIN_EMAIL=cuelane-yoursuffix@admin.local
PGADMIN_PASSWORD=your-pgadmin-password-here

# XENDIT (payment gateway — conditional: payment.gateway: xendit)
# Dev uses TEST keys — no real charges
# XENDIT_SECRET_KEY=xnd_development_your-test-secret-key
# XENDIT_PUBLIC_KEY=xnd_public_development_your-test-public-key
# XENDIT_WEBHOOK_TOKEN=your-xendit-webhook-verification-token

# CLOUDFLARE TURNSTILE (bot protection — framework default)
# Dev + staging use official Cloudflare test keys (always pass) — replace for prod
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# ↑ These are Cloudflare's official test keys. Replace with real keys for production.
# Production keys: dash.cloudflare.com → Turnstile → your widget

# APP CONFIG
NEXT_PUBLIC_APP_URL=http://localhost:41716
APP_SLUG=cuelane
