{
  "name": "@cuelane/root",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @cuelane/db generate",
    "db:migrate": "pnpm --filter @cuelane/db migrate:dev",
    "db:studio": "pnpm --filter @cuelane/db studio",
    "db:seed": "pnpm --filter @cuelane/db seed",
    "tools:validate-inputs": "node tools/validate-inputs.mjs",
    "tools:check-env": "node tools/check-env.mjs",
    "tools:check-product-sync": "node tools/check-product-sync.mjs",
    "tools:hydration-lint": "node tools/hydration-lint.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^9",
    "prettier": "^3",
    "turbo": "^2",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "yaml": "^2"
  }
}
